WITH DADOS_PRODUTO AS (
    SELECT  
        A.NR_SEQUENCIA, 
        COALESCE(A.NR_PROTOCOLO_ANS, A.CD_SCPA) AS REG_PLANO
    FROM PLS_PLANO A
)
SELECT 
    A.NR_SEQ_LOTE,
    A.NR_CCO,
    A.NR_SEQ_SEGURADO,
    A.CD_BENEFICIARIO AS MATRICULA,
    A.NM_BENEFICIARIO,
    A.NR_CPF,
    A.DT_NASCIMENTO,
    A.NM_MAE,
    CASE WHEN A.IE_SEXO = '3' THEN 'F' WHEN A.IE_SEXO = '1' THEN 'M' ELSE 'INVÁLIDO' END AS SEXO,
    (SELECT C.DS_MUNICIPIO FROM SUS_MUNICIPIO C WHERE C.CD_MUNICIPIO_IBGE = A.CD_MUNICIPIO_IBGE) AS MUNICIPIO,
    A.IE_TIPO_DEPENDENCIA,
    A.NR_CCO_TITULAR,
    A.DT_CONTRATACAO,
    A.DT_REATIVACAO,
    A.DT_CANCELAMENTO,
    A.DT_ATUALIZACAO_SIB,
    A.DS_SITUACAO,
    A.DT_PRIMEIRA_CONTRATACAO,
    COALESCE(A.NR_PLANO_ANS, A.NR_PLANO_OPS) AS REG_PLANO,
    pls_obter_dados_produto(B.NR_SEQUENCIA, 'N') AS NOME_PRODUTO,
    pls_obter_dados_produto(B.NR_SEQUENCIA, 'C') AS TIPO_CONTRATACAO,
    pls_obter_dados_produto(B.NR_SEQUENCIA, 'S') AS SEGMENTACAO,
    CASE 
        WHEN pls_obter_dados_produto(B.NR_SEQUENCIA, 'R') = 'R' THEN 'PRE'
        WHEN pls_obter_dados_produto(B.NR_SEQUENCIA, 'R') = 'P' THEN 'POS'
        WHEN pls_obter_dados_produto(B.NR_SEQUENCIA, 'R') = 'A' THEN 'ADAPTADO'
    END AS REGULAMENTACAO
FROM PLS_SIB_CONFERENCIA A
LEFT JOIN DADOS_PRODUTO B ON B.REG_PLANO = COALESCE(A.NR_PLANO_ANS, A.NR_PLANO_OPS)
WHERE A.NR_SEQ_LOTE = :LOTE_SIB 
  AND (
      (:TIPO_FILTRO = '1' AND A.DT_CONTRATACAO BETWEEN :DATA_1_INICIAL AND :DATA_2_FIM)
      OR 
      (:TIPO_FILTRO = '2' AND A.DT_CANCELAMENTO BETWEEN :DATA_1_INICIAL AND :DATA_2_FIM)
      OR
      (:TIPO_FILTRO = '3' AND A.DS_SITUACAO = 'ATIVO')
  )
ORDER BY 
    CASE 
        WHEN :TIPO_FILTRO = '1' THEN A.DT_CONTRATACAO 
        ELSE A.DT_CANCELAMENTO 
    END
